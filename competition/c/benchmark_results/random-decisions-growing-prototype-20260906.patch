+static Var random_decision(Solver *s) {
+    if (!s->num_vars || s->stable_mode) return INVALID_VAR;
+    uint64_t conflicts = s->stats.conflicts;
+    uint64_t interval = s->opts.random_decision_interval;
+    if (!s->next_random) s->next_random = interval;
+    if (!s->decision_level && conflicts >= s->random_until && conflicts >= s->next_random &&
+        s->stats.random_sequences < UINT64_MAX) {
+        double scale = log10((double)s->stats.random_sequences + 10.0);
+        uint64_t length = (uint64_t)(10.0*scale);
+        uint64_t gap = (uint64_t)(interval*scale);
+        if (conflicts <= UINT64_MAX-MAX(gap, length)) {
+            s->random_until = conflicts+length;
+            s->next_random = conflicts+gap;
+            ++s->stats.random_sequences;
+        }
+    }
+    if (conflicts >= s->random_until) return INVALID_VAR;
+    /* Rejection sampling is bounded: sparse remaining assignments must not
+       turn diversification into an unbounded scan. Fall back to the heuristic. */
+    for (unsigned attempt = 0; attempt < 32; ++attempt) {
+        Var v = 1 + bsat_random(&s->random_state) % s->num_vars;
+        if (s->values[v] != UNDEF || (s->elim && s->elim->eliminated[v])) continue;
+        ++s->stats.random_decisions;
+        return v;
+    }
+    return INVALID_VAR;
+}
