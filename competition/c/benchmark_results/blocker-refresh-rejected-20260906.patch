+/* Controlled decisions keep the watch-movement history reproducible. */
+static void enqueue_test_decision(Solver *s, Lit lit) {
+    Var v = var(lit);
+    assert(s->values[v] == UNDEF);
+    s->trail_lims[++s->decision_level] = s->trail_size;
+    s->values[v] = sign(lit) ? FALSE : TRUE;
+    s->vars[v].level = s->decision_level;
+    s->vars[v].reason = INVALID_CLAUSE;
+    s->vars[v].trail_pos = s->trail_size;
+    s->trail[s->trail_size++] = (Trail){lit, s->decision_level};
+}
+static void refreshed_blocker(void) {
+    for (unsigned circular = 0; circular < 2; ++circular) {
+        Solver *s = formula("p cnf 3 1\n1 2 3 0\n");
+        s->opts.circular = circular;
+        /* Move watch 2 to 3, then falsify 1 so that 3 is implied. */
+        enqueue_test_decision(s, mkLit(2, true));
+        assert(solver_propagate(s) == INVALID_CLAUSE);
+        enqueue_test_decision(s, mkLit(1, true));
+        assert(solver_propagate(s) == INVALID_CLAUSE);
+        assert(s->values[3] == TRUE && s->vars[3].reason == s->clauses[0]);
+        solver_backtrack(s, 0);
+
+        /* On another branch 3 is already true and the old blocker 2 is
+           unassigned. Revisiting watch 1 must use the cached satisfying 3. */
+        enqueue_test_decision(s, mkLit(3, false));
+        assert(solver_propagate(s) == INVALID_CLAUSE);
+        uint64_t skipped = s->watches->skipped;
+        enqueue_test_decision(s, mkLit(1, true));
+        assert(solver_propagate(s) == INVALID_CLAUSE);
+        assert(s->watches->skipped == skipped + 1);
+        assert(s->values[2] == UNDEF && s->trail_size == 2);
+        solver_backtrack(s, 0);
+        assert(solver_solve(s) == TRUE && solver_check_model(s));
+        solver_free(s);
+    }
+}
