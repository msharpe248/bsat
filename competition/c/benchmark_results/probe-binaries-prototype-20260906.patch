+#include "../include/solver.h"
+#include <assert.h>
+#include <stdio.h>
+
+static void add(Solver *s, const int *xs, unsigned n) {
+    Lit lits[4];
+    for (unsigned i = 0; i < n; ++i) lits[i] = fromDimacs(xs[i]);
+    assert(solver_add_clause(s, lits, n));
+}
+
+static bool binary(Solver *s, int a, int b) {
+    WatchList *wl = watch_list(s->watches, fromDimacs(a));
+    for (unsigned i = 0; i < wl->size; ++i)
+        if (is_binary_watch(wl->watches[i]) && wl->watches[i].blocker == fromDimacs(b)) return true;
+    return false;
+}
+
+static Solver *formula(bool enabled, bool queue, uint64_t budget, bool root) {
+    SolverOpts o = default_opts();o.probe_binaries = enabled;o.vmtf = queue;
+    o.preprocess_budget = budget;
+    Solver *s = solver_new_with_opts(&o);assert(s);
+    for (unsigned i = 0; i < 6; ++i) assert(solver_new_var(s));
+    /* Assuming 1 implies 2 and 3, then the long clause implies 4.
+       The second long clause also uses a root assignment when requested. */
+    add(s, (int[]){-1, 2}, 2);add(s, (int[]){-1, 3}, 2);
+    add(s, (int[]){-2, -3, 4}, 3);
+    if (root) { add(s, (int[]){-5}, 1);add(s, (int[]){-2, 5, 6}, 3); }
+    return s;
+}
+
+int main(void) {
+    for (unsigned queue = 0; queue < 2; ++queue) {
+        Solver *s = formula(true, queue, 1000000, true);
+        size_t input = s->input_size;
+        assert(solver_solve(s) == TRUE && solver_check_model(s));
+        assert(s->stats.probe_binaries && binary(s, -1, 4) && binary(s, 4, -1));
+        assert(binary(s, -1, 6) && s->input_size == input);
+        for (unsigned i = 0; i < s->num_clauses; ++i)
+            assert(!clause_deleted(s->arena, s->clauses[i]));
+        Lit assumptions[] = {fromDimacs(1), fromDimacs(-4)};
+        assert(solver_solve_with_assumptions(s, assumptions, 2) == FALSE);
+        assert(solver_solve(s) == TRUE && solver_check_model(s));
+        assert(s->input_size == input && s->opts.probe_binaries);
+        solver_free(s);
+        s = formula(false, queue, 1000000, false);
+        assert(solver_solve(s) == TRUE && !s->stats.probe_binaries);solver_free(s);
+        for (unsigned budget = 0; budget < 100; ++budget) {
+            s = formula(true, queue, budget, false);
+            assert(solver_solve(s) == TRUE && solver_check_model(s));solver_free(s);
+        }
+        /* A direct binary implication should not be duplicated. */
+        s = formula(true, queue, 1000000, false);
+        add(s, (int[]){-1, 4}, 2);
+        assert(solver_solve(s) == TRUE);
+        WatchList *wl = watch_list(s->watches, fromDimacs(-1));unsigned count = 0;
+        for (unsigned i = 0; i < wl->size; ++i)
+            count += is_binary_watch(wl->watches[i]) && wl->watches[i].blocker == fromDimacs(4);
+        assert(count == 1);solver_free(s);
+    }
+    puts("PASS: binary probe consequences, root assumptions, budgets, duplicates and rebuilds");
+    return 0;
+}
