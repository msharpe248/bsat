+/* Sample before conflict analysis/backtracking. Only adaptive focused restarts
+   use this window; no allocation or scan occurs on the conflict path. */
+void solver_record_restart_trail(Solver *s) {
+    if (!s->opts.block_restarts || !s->restart.recent_trails ||
+        !s->opts.glucose_restart || s->opts.luby_restart ||
+        (s->opts.alternating && s->stable_mode) ||
+        s->opts.restart_first == UINT32_MAX) return;
+    uint32_t at = s->restart.trail_head;
+    if (s->restart.trail_count == 5000)
+        s->restart.trail_sum -= s->restart.recent_trails[at];
+    else ++s->restart.trail_count;
+    s->restart.recent_trails[at] = s->trail_size;
+    s->restart.trail_sum += s->trail_size;
+    s->restart.trail_head = (at + 1) % 5000;
+    // Exact 1.4 comparison; products fit uint64_t even at MAX_VARS.
+    if (s->stats.conflicts > 10000 && s->restart.trail_count == 5000 &&
+        s->restart.recent_lbds_count == s->opts.glucose_window_size &&
+        (uint64_t)s->trail_size * 5 * 5000 > s->restart.trail_sum * 7) {
+        ++s->restart.blocked;
+        s->restart.recent_lbds_count = s->restart.recent_lbds_head = 0;
+        s->recent_lbd_sum = 0;
+    }
+}
+
