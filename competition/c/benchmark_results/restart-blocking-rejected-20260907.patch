diff --git a/competition/c/tests/test_restart_blocking.c b/competition/c/tests/test_restart_blocking.c
new file mode 100644
index 0000000..1f06db5
--- /dev/null
+++ b/competition/c/tests/test_restart_blocking.c
@@ -0,0 +1,65 @@
+#include "../include/solver.h"
+#include <assert.h>
+#include <stdio.h>
+
+static Solver *fresh(void) {
+    SolverOpts o=default_opts();o.block_restarts=true;
+    Solver *s=solver_new_with_opts(&o);assert(s && s->restart.recent_trails);
+    s->restart.trail_count=5000;s->restart.trail_sum=500000;
+    for(unsigned i=0;i<5000;++i) s->restart.recent_trails[i]=100;
+    s->restart.recent_trails[0]=140;s->restart.recent_trails[4999]=60;
+    s->stats.conflicts=10001;s->lbd_samples=10001;
+    s->restart.recent_lbds_count=s->opts.glucose_window_size;
+    s->restart.conflicts_since=100;s->restart.fast_ma=20;s->restart.slow_ma=2;
+    s->restart.lbd_count=10001;s->restart.lbd_sum=20002;
+    s->recent_lbd_sum=20*s->opts.glucose_window_size;
+    return s;
+}
+int main(void) {
+    unsigned checks=0;
+    for(unsigned ema=0;ema<2;++ema) for(unsigned trail=139;trail<=141;++trail) {
+        Solver *s=fresh();s->opts.glucose_use_ema=ema;s->trail_size=trail;
+        solver_record_restart_trail(s);
+        assert(s->restart.blocked==(trail==141));
+        assert(solver_should_restart(s)==(trail!=141));
+        if(trail==141) {
+            assert(!s->restart.recent_lbds_count && !s->recent_lbd_sum);
+            assert(s->restart.conflicts_since==100);
+            s->restart.recent_lbds_count=s->opts.glucose_window_size-1;
+            assert(!solver_should_restart(s));
+            s->restart.recent_lbds_count=s->opts.glucose_window_size;
+            s->recent_lbd_sum=20*s->opts.glucose_window_size;
+            assert(solver_should_restart(s));
+        }
+        solver_free(s);++checks;
+    }
+    for(unsigned mode=0;mode<7;++mode) {
+        Solver *s=fresh();s->trail_size=1000;
+        if(mode==0) s->stats.conflicts=10000;
+        if(mode==1) s->opts.block_restarts=false;
+        if(mode==2) s->opts.luby_restart=true;
+        if(mode==3) s->opts.glucose_restart=false;
+        if(mode==4) {s->opts.alternating=true;s->stable_mode=true;}
+        if(mode==5) s->opts.restart_first=UINT32_MAX;
+        if(mode==6) s->restart.recent_lbds_count=49;
+        solver_record_restart_trail(s);assert(!s->restart.blocked);
+        if(mode>=1 && mode<=5) assert(s->restart.trail_head==0);
+        solver_free(s);++checks;
+    }
+    SolverOpts o=default_opts();o.block_restarts=true;
+    Solver *s=solver_new_with_opts(&o);assert(s);
+    uint32_t samples[15000];
+    for(unsigned i=0;i<15000;++i) {
+        samples[i]=(i*31u)%1009;s->trail_size=samples[i];s->stats.conflicts=i+1;
+        solver_record_restart_trail(s);
+        assert(s->restart.trail_count==MIN(i+1,5000));
+        if(i%499==0 || i==14999) {
+            uint64_t sum=0;
+            for(unsigned j=i+1-s->restart.trail_count;j<=i;++j) sum+=samples[j];
+            assert(sum==s->restart.trail_sum);++checks;
+        }
+    }
+    solver_free(s);
+    s=solver_new();assert(s && !s->restart.recent_trails);solver_free(s);
+    printf("PASS: %u restart blocking boundary/mode/rolling-window checks\n",checks);
+}
