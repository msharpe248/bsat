+++ b/competition/c/tests/test_activity.c
@@ -0,0 +1,83 @@
+#include "../include/solver.h"
+#include "../include/dimacs.h"
+#include <assert.h>
+#include <float.h>
+#include <math.h>
+#include <stdio.h>
+
+static void ranking(bool recency, bool rescale) {
+    Solver *s = solver_new();assert(s);
+    s->opts.recency_activity = recency;
+    assert(dimacs_parse_string(s, "p cnf 4 3\n-1 -2 3 4 0\n-1 -2 3 -4 0\n-1 -3 0\n") == DIMACS_OK);
+    CRef reason = s->clauses[0], conflict = s->clauses[1];
+    CRef unused = arena_alloc(s->arena, CLAUSE_LITS(s->arena, reason), 4, true);
+    assert(unused != INVALID_CLAUSE);
+    s->learnts = malloc(3 * sizeof *s->learnts);assert(s->learnts);
+    s->learnts[0] = reason;s->learnts[1] = conflict;s->learnts[2] = unused;
+    s->num_learnts = s->learnts_size = 3;
+    for (unsigned i = 0; i < 3; ++i) {
+        CLAUSE_HEADER(s->arena, s->learnts[i])->flags |= CLAUSE_LEARNED;
+        set_clause_lbd(s->arena, s->learnts[i], 4);
+    }
+    CLAUSE_HEADER(s->arena, reason)->activity = rescale ? 1e20f : 20;
+    CLAUSE_HEADER(s->arena, conflict)->activity = 10;
+    CLAUSE_HEADER(s->arena, unused)->activity = 30;
+    s->clause_inc = rescale ? 1e20 : 100;
+    for (Var v = 1; v <= 2; ++v) {
+        assert(s->values[v] == UNDEF);
+        s->trail_lims[++s->decision_level] = s->trail_size;
+        s->values[v] = TRUE;s->vars[v].level = s->decision_level;
+        s->vars[v].reason = INVALID_CLAUSE;s->vars[v].trail_pos = s->trail_size;
+        s->trail[s->trail_size++] = (Trail){mkLit(v, false), s->decision_level};
+        CRef found = solver_propagate(s);
+        assert(found == (v == 1 ? INVALID_CLAUSE : conflict));
+    }
+    assert(s->vars[4].reason == reason);
+    Lit learned[4];uint32_t n;Level backjump;
+    solver_analyze(s, conflict, learned, &n, &backjump);
+    assert(n && backjump == 1 && learned[0] == mkLit(2, true));
+    float a = clause_activity(s->arena, reason), b = clause_activity(s->arena, conflict);
+    if (rescale) {
+        assert(isfinite(s->clause_inc) && fabs(s->clause_inc - 1) < 1e-5);
+        assert(fabs(a - 2) < 1e-5 && fabs(b - 1) < 1e-5);
+        assert(clause_activity(s->arena, unused) < 1e-15);
+    } else {
+        assert(a == (recency ? 120 : 21) && b == (recency ? 110 : 10));
+    }
+    solver_backtrack(s, 0);
+    s->opts.reduce_fraction = 0.34; // Keep exactly one of the three equal-LBD clauses.
+    solver_reduce_db(s);
+    assert(s->num_learnts == 1);
+    // GC may relocate the retained clause; its activity identifies the winner.
+    float retained = clause_activity(s->arena, s->learnts[0]);
+    assert(fabs(retained - (recency ? a : 30 * s->opts.clause_decay)) < 1e-5);
+    solver_free(s);
+}
+
+static void decay_and_reuse(void) {
+    const double factors[] = {0.999, 0.5, DBL_MIN, 1};
+    for (unsigned i = 0; i < sizeof factors/sizeof *factors; ++i) {
+        SolverOpts o = default_opts();o.recency_activity = true;o.probing = false;
+        o.clause_decay = factors[i];
+        Solver *s = solver_new_with_opts(&o);assert(s);
+        // Neither branch of variable 1 works. Search learns a root unit first.
+        assert(dimacs_parse_string(s,"p cnf 3 4\n1 2 0\n1 -2 0\n-1 3 0\n-1 -3 0\n") == DIMACS_OK);
+        assert(solver_solve(s) == FALSE && s->stats.learned_clauses > 0);
+        assert(isfinite(s->clause_inc) && s->clause_inc > 0 && s->clause_inc <= 1e20);
+        if (factors[i] >= 0.5) assert(fabs(s->clause_inc - 1/factors[i]) < 1e-10);
+        else assert(s->clause_inc == 1);
+        assert(solver_solve(s) == FALSE); // Rebuilding must reset the shared scale.
+        if (factors[i] >= 0.5) assert(fabs(s->clause_inc - 1/factors[i]) < 1e-10);
+        solver_free(s);
+    }
+    const double invalid[] = {0, -1, 1.01, INFINITY, NAN};
+    for (unsigned i = 0; i < sizeof invalid/sizeof *invalid; ++i) {
+        SolverOpts o = default_opts();o.clause_decay = invalid[i];
+        assert(!solver_new_with_opts(&o));
+    }
+}
+int main(void) {
+    ranking(false, false);ranking(true, false);ranking(true, true);decay_and_reuse();
+    puts("PASS: clause recency, conflict/reason rewards, ranking, rescaling, decay bounds and reuse");
+    return 0;
+}
