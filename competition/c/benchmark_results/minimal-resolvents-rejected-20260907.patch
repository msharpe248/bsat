+            if(cap<=rs->size || SIZE_MAX/cap<sizeof *rs->items) {free(lits);s->error=true;return false;}
+            Resolvent *items=realloc(rs->items,(size_t)cap*sizeof *items);
+            if(!items) {free(lits);s->error=true;return false;}
