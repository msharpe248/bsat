+static void refresh_policy(void) {
+    for (unsigned diversify = 0; diversify < 2; ++diversify) {
+        SolverOpts o = default_opts();o.probing = false;o.rephase_refresh = true;
+        o.rephase_diversify = diversify;o.rephase_interval = 1;o.max_decisions = 1;
+        Solver *s = solver_new_with_opts(&o);assert(s);
+        for (unsigned v = 1; v <= 4; ++v) assert(solver_new_var(s) == v);
+        s->rephase.best_phase[1] = FALSE;s->rephase.best_trail_size = 4;
+        s->rephase.best_prefix_valid = false;s->rephase.rephase_count = 2;
+        s->stats.conflicts = 1;
+        assert(solver_solve(s) == UNDEF && !s->error);
+        assert(s->rephase.rephase_count == 3);
+        assert(s->rephase.best_trail_size < 4); // Old record no longer gates updates.
+        Var v = var(s->trail[0].lit);
+        assert(s->values[v] == (diversify ? TRUE : FALSE));
+        assert(s->vars[v].reason == INVALID_CLAUSE);
+        solver_backtrack(s, 0);
+        assert(solver_decide(s));solver_maybe_save_best_phases(s);
+        assert(s->rephase.best_trail_size == 1);
+        solver_free(s);
+    }
