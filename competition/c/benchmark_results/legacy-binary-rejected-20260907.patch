@@ -180,0 +181,41 @@ static void legacy_limits(void) {
+static void legacy_binaries(void) {
+    unsigned checks = 0;
+    for (unsigned signs = 0; signs < 16; ++signs)
+    for (unsigned budget = 0; budget <= 4; ++budget) {
+        Solver *s = new_solver(5);s->opts.iterative_minimize = false;
+        Lit assigned[6];
+        for (Var v = 1; v <= 5; ++v) assigned[v] = mkLit(v, v <= 4 && (signs & (1u << (v-1))));
+        unsigned from[] = {1, 2, 2}, to[] = {2, 3, 4};
+        for (unsigned i = 0; i < 3; ++i) {
+            Lit c[] = {neg(assigned[from[i]]), assigned[to[i]]};
+            assert(solver_add_clause(s, c, 2));
+        }
+        Lit source[] = {assigned[5], neg(assigned[1]), neg(assigned[3]), neg(assigned[4])};
+        assert(solver_add_clause(s, source, 4));decision(s, assigned[1]);
+        s->opts.minimize_budget = budget;unsigned n = 4;
+        unsigned removed = budget / 2; // Each candidate needs its own two-edge proof.
+        assert(solver_minimize_clause(s, source, &n) == removed && n == 4-removed);
+        assert(source[0] == assigned[5] && source[1] == neg(assigned[1]));
+        entailed(s, source, n);clean(s);solver_free(s);++checks;
+    }
+    for (unsigned length = 129; length <= 130; ++length) {
+        Solver *s = new_solver(length+1);s->opts.iterative_minimize = false;
+        for (Var v = 1; v < length; ++v) edge(s, v, v+1);
+        Lit source[] = {mkLit(length+1, false), mkLit(1, true), mkLit(length, true)};
+        assert(solver_add_clause(s, source, 3));decision(s, mkLit(1, false));
+        unsigned n = 3;
+        assert(solver_minimize_clause(s, source, &n) == (length == 129));
+        assert(n == (length == 129 ? 2u : 3u));clean(s);solver_free(s);++checks;
+    }
+    for (unsigned stale = 0; stale < 2; ++stale) {
+        Solver *s = new_solver(5);s->opts.iterative_minimize = false;
+        edge(s, 1, 2);edge(s, 2, 3);edge(s, 2, 4);
+        Lit source[] = {mkLit(5, false), mkLit(1, true), mkLit(3, true), mkLit(4, true)};
+        assert(solver_add_clause(s, source, 4));decision(s, mkLit(1, false));
+        s->binary_reasons[3] = mkLit(stale ? 5 : 3, true);
+        unsigned n = 4;assert(solver_minimize_clause(s, source, &n) == 1 && n == 3);
+        assert(source[2] == mkLit(3, true));entailed(s, source, n);clean(s);solver_free(s);++checks;
+    }
+    assert(checks == 84);
+    puts("PASS: 84 recursive binary cases, signed truth tables, per-candidate budgets, depth boundary and stale reasons");
+}
