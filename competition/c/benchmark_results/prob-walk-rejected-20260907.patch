diff --git a/competition/c/tests/test_probabilistic_walk.c b/competition/c/tests/test_probabilistic_walk.c
new file mode 100644
index 0000000..d0d480a
--- /dev/null
+++ b/competition/c/tests/test_probabilistic_walk.c
@@ -0,0 +1,42 @@
+#include "../include/solver.h"
+#include "../include/local_search.h"
+#include "../include/dimacs.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    SolverOpts o=default_opts();o.ls_probabilistic=true;
+    Solver *s=solver_new_with_opts(&o);assert(s);
+    /* With all phases false, only (x1 or x2) is unsatisfied. Flipping x1
+       breaks two clauses; flipping x2 breaks none: weights are 1/9 and 1. */
+    assert(dimacs_parse_string(s,"p cnf 4 3\n1 2 0\n-1 3 0\n-1 4 0\n")==DIMACS_OK);
+    LocalSearchState *ls=local_search_init(s);assert(ls);
+    unsigned chosen2=0;
+    for(unsigned seed=1;seed<=10000;++seed) {
+        uint32_t rng=seed;
+        (void)bsat_random(&rng); /* Unsatisfied-clause rank. */
+        double draw=bsat_random(&rng)/4294967296.0;
+        bool expect2=draw*(1.0+1.0/9.0)<1.0;
+        ls->random_state=seed;ls->flips=0;
+        bool found=local_search_run(s,ls,1,0.0);
+        assert(ls->flips==1 && ls->random_state==rng);
+        assert(ls->assignment[2]==expect2 && ls->assignment[1]!=expect2);
+        assert(found==expect2);chosen2+=expect2;
+    }
+    assert(chosen2>8800 && chosen2<9200);
+    local_search_free(ls);solver_free(s);
+    /* Root values must be excluded even when their saved phases disagree. */
+    s=solver_new_with_opts(&o);assert(s);
+    assert(dimacs_parse_string(s,"p cnf 3 2\n1 0\n-1 2 3 0\n")==DIMACS_OK);
+    assert(solver_propagate(s)==INVALID_CLAUSE);
+    ls=local_search_init(s);assert(ls);
+    for(unsigned seed=0;seed<128;++seed) {
+        ls->random_state=seed;ls->flips=0;
+        assert(local_search_run(s,ls,1,1.0));
+        assert(ls->assignment[1] && (ls->assignment[2] || ls->assignment[3]));
+        assert(ls->flips==1);
+    }
+    local_search_free(ls);solver_free(s);
+    puts("PASS: inverse-square break probabilities, deterministic draws and fixed roots");
+    return 0;
+}
