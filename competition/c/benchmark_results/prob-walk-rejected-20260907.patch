+/* Weighted reservoir sampling avoids per-flip allocation or a second scoring
+   pass. The probability of each movable variable is proportional to
+   1 / (1 + breaks)^2, where breaks counts only currently satisfied clauses. */
+static Var pick_probabilistic(Solver *s, LocalSearchState *ls, uint32_t c, bool fixed) {
+    double total = 0;
+    Var chosen = INVALID_VAR;
+    for (uint32_t i = 0; i < ls->clause_sizes[c]; ++i) {
+        if (!(i & 127) && solver_budget_exhausted_now(s)) return INVALID_VAR;
+        Var v = var(ls->clause_lits[c][i]);
+        if (fixed && root_fixed(s, v)) continue;
+        uint32_t *occs = ls->assignment[v] ? ls->pos_occs[v] : ls->neg_occs[v];
+        uint32_t count = ls->assignment[v] ? ls->pos_occ_count[v] : ls->neg_occ_count[v];
+        uint32_t breaks = 0;
+        for (uint32_t j = 0; j < count; ++j) {
+            if (j && !(j & 1023) && solver_budget_exhausted_now(s)) return INVALID_VAR;
+            breaks += ls->num_true_lits[occs[j]] == 1;
+        }
+        double denominator = 1.0 + breaks;
+        double weight = 1.0 / (denominator * denominator);
+        total += weight;
+        if (chosen == INVALID_VAR ||
+            (bsat_random(&ls->random_state) / 4294967296.0) * total < weight)
+            chosen = v;
+    }
+    return chosen;
+}
