+#ifdef BSAT_CACHE_MINIMIZE_FAILURES
+            if (s->opts.assumption_lbd) {
+                /* Failure caching is conservative even for depth-dependent
+                   failures: it can only retain a literal. Clear per candidate. */
+                ASSERT(*touched < s->num_vars + 1);
+                s->minimize_touched[(*touched)++] = v;
+                s->seen[v] = 255;
+            } else
+#endif
+                s->seen[v] = orig_seen;
             return false;
         }
         if (child_height + 1 > max_height) max_height = child_height + 1;
