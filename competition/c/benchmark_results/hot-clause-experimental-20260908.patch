diff --git a/competition/c/tests/test_hot_vivify.c b/competition/c/tests/test_hot_vivify.c
new file mode 100644
index 0000000..88ef49a
--- /dev/null
+++ b/competition/c/tests/test_hot_vivify.c
@@ -0,0 +1,34 @@
+#include "solver.h"
+#include <assert.h>
+#include <stdio.h>
+int main(void) {
+    const unsigned budgets[]={1,32,512,25000,1000000};
+    for(unsigned b=0;b<5;++b) {
+        SolverOpts o=default_opts();o.inprocess=o.hot_vivify=true;
+        o.inprocess_interval=1;o.preprocess_budget=budgets[b];o.probing=false;
+        Solver *s=solver_new_with_opts(&o);assert(s);
+        for(unsigned i=0;i<4;++i) assert(solver_new_var(s));
+        Lit base[]={mkLit(1,false),mkLit(2,false)};
+        assert(solver_add_clause(s,base,2));
+        Lit c[]={base[0],base[1],mkLit(3,false),mkLit(4,false)};
+        s->learnts=malloc(600*sizeof(CRef));assert(s->learnts);s->learnts_size=600;
+        for(unsigned i=0;i<600;++i) {
+            CRef cr=arena_alloc(s->arena,c,4,true);assert(cr!=INVALID_CLAUSE);
+            CLAUSE_HEADER(s->arena,cr)->heat=4096+i;
+            s->learnts[s->num_learnts++]=cr;
+            watch_add(s->watches,c[0],cr,c[1]);watch_add(s->watches,c[1],cr,c[0]);
+        }
+        s->stats.conflicts=1;uint64_t before=s->work;
+        assert(solver_simplify(s));
+        assert(!s->error && !s->interrupted && !s->decision_level && !s->work_limit);
+        assert(s->work-before<=MIN(budgets[b],25000u));
+        unsigned changed=0;
+        for(unsigned i=0;i<600;++i) {
+            unsigned n=CLAUSE_SIZE(s->arena,s->learnts[i]);
+            if(n<4) {++changed;assert(i>=508 && i<=511 && n==2);}
+        }
+        assert(changed==(budgets[b]>=25000?4:0));
+        assert(solver_solve(s)==TRUE && solver_check_model(s));solver_free(s);
+    }
+    puts("PASS: bounded 512-record window, top-four selection and five work cutoffs");
+}
