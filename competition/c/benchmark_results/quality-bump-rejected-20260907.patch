+// Analysis visits each candidate once. Keep this list separate from minimizer scratch.
+static void collect_quality_candidate(Solver *s, Var v) {
+    if (!s->opts.quality_bump || s->opts.vmtf || s->opts.lrb || s->error) return;
+    CRef reason = s->vars[v].reason;
+    if (s->vars[v].level != s->decision_level || reason == INVALID_CLAUSE ||
+        reason == BINARY_CONFLICT || !clause_learned(s->arena, reason)) return;
+    ASSERT(s->quality_count < s->quality_capacity);
+    s->quality_candidates[s->quality_count++] = v;
+}
+
+// Apply after both minimizers and final LBD calculation, before backtracking.
+void solver_bump_quality(Solver *s, uint32_t lbd) {
+    uint32_t count = s->quality_count;
+    s->quality_count = 0;
+    if (!s->opts.quality_bump || s->opts.vmtf || s->opts.lrb) return;
+    for (uint32_t i = 0; i < count; ++i) {
+        if (!(i & 1023) && solver_budget_exhausted_now(s)) break;
+        Var v = s->quality_candidates[i];
+        CRef reason = s->vars[v].reason;
+        if (reason == INVALID_CLAUSE || reason == BINARY_CONFLICT ||
+            clause_deleted(s->arena, reason) || !clause_learned(s->arena, reason) ||
+            s->vars[v].level != s->decision_level || clause_lbd(s->arena, reason) >= lbd) continue;
+        bump_var_activity(s, v, s->order.var_inc);
+        s->stats.quality_bumps++;
+    }
+}
