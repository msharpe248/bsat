diff --git a/competition/c/tests/test_quality_bump.c b/competition/c/tests/test_quality_bump.c
new file mode 100644
index 0000000..ea23c32
--- /dev/null
+++ b/competition/c/tests/test_quality_bump.c
@@ -0,0 +1,75 @@
+#include "../include/solver.h"
+#include "../include/dimacs.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <time.h>
+
+int main(void) {
+    unsigned checks=0;
+    for(unsigned enabled=0;enabled<2;++enabled)
+    for(unsigned learned=0;learned<2;++learned)
+    for(unsigned final_lbd=0;final_lbd<6;++final_lbd)
+    for(unsigned lbd=1;lbd<=4;++lbd)
+    for(unsigned vmtf=0;vmtf<2;++vmtf)
+    for(unsigned lrb=0;lrb<2;++lrb)
+    for(unsigned cancelled=0;cancelled<3;++cancelled)
+    for(unsigned large=0;large<2;++large) {
+        SolverOpts o=default_opts();o.quality_bump=enabled;o.vmtf=vmtf;o.lrb=lrb;
+        o.var_inc=large?9e99:1.0;
+        Solver *s=solver_new_with_opts(&o);assert(s);
+        assert(dimacs_parse_string(s,"p cnf 5 4\n-1 -2 3 4 0\n-1 -2 3 -4 0\n-1 -5 -3 0\n5 0\n")==DIMACS_OK);
+        // A lower-level glue reason participates too, but must receive no bonus.
+        CLAUSE_HEADER(s->arena,s->clauses[2])->flags|=CLAUSE_LEARNED;
+        set_clause_lbd(s->arena,s->clauses[2],1);
+        assert(solver_propagate(s)==INVALID_CLAUSE);
+        CRef reason=s->clauses[0],conflict=INVALID_CLAUSE;
+        set_clause_lbd(s->arena,reason,lbd);
+        if(learned) CLAUSE_HEADER(s->arena,reason)->flags|=CLAUSE_LEARNED;
+        for(Var v=1;v<=2;++v) {
+            s->trail_lims[++s->decision_level]=s->trail_size;
+            s->values[v]=TRUE;s->vars[v].level=s->decision_level;
+            s->vars[v].reason=INVALID_CLAUSE;s->vars[v].trail_pos=s->trail_size;
+            s->trail[s->trail_size++]=(Trail){mkLit(v,false)};
+            conflict=solver_propagate(s);
+        }
+        assert(conflict==s->clauses[1] && s->vars[4].reason==reason);
+        assert(s->vars[3].reason==s->clauses[2] && s->vars[3].level==1);
+        Lit learnt[6];uint32_t size;Level backjump;
+        solver_analyze(s,conflict,learnt,&size,&backjump);
+        bool active=enabled && !vmtf && !lrb;
+        assert(s->quality_count==(unsigned)(active && learned));
+        assert(!!s->quality_candidates==active);
+        assert(!s->stats.quality_bumps);
+        assert(size==3 && learnt[0]==mkLit(2,true) && learnt[1]==mkLit(1,true) && learnt[2]==mkLit(3,false) && backjump==1);
+        unsigned removed=solver_minimize_clause(s,learnt,&size);
+        assert(removed==1 && size==2); // Minimizer scratch must not corrupt candidates.
+        if(cancelled==1) s->interrupted=true;
+        if(cancelled==2) {
+            s->opts.max_time=0.001;
+            s->stats.start_time=(double)clock()/CLOCKS_PER_SEC-1.0;
+            s->clock_initialized=true;s->clock_polls=0;
+            s->clock_work=s->work;s->clock_minimize=s->stats.minimize_inspections;
+        }
+        solver_bump_quality(s,final_lbd);
+        bool bonus=active && learned && lbd<final_lbd && !cancelled;
+        assert(s->stats.quality_bumps==(unsigned)bonus && !s->quality_count);
+        solver_bump_quality(s,final_lbd); // A consumed list must not reward twice.
+        assert(s->stats.quality_bumps==(unsigned)bonus);
+        for(Var v=1;v<=4;++v) {
+            assert(!s->seen[v]);assert(isfinite(s->vars[v].activity));
+            if(!vmtf && !lrb)
+                assert(fabs(s->vars[v].activity/s->order.var_inc-(v==4 && bonus?2.0:1.0))<1e-12);
+        }
+        assert(isfinite(s->order.var_inc));
+        if(active && learned && !cancelled && !large) {
+            while(s->num_vars<9) assert(solver_new_var(s));
+            solver_analyze(s,conflict,learnt,&size,&backjump);
+            assert(s->quality_capacity>=9 && s->quality_count==1);
+            solver_bump_quality(s,final_lbd);
+            assert(!s->quality_count);
+        }
+        solver_free(s);++checks;
+    }
+    printf("PASS: %u quality-reason reward, minimization, cancellation and rescaling cases\n",checks);
+}
