diff --git a/competition/c/tests/test_reason_side.c b/competition/c/tests/test_reason_side.c
new file mode 100644
index 0000000..c38f6a6
--- /dev/null
+++ b/competition/c/tests/test_reason_side.c
@@ -0,0 +1,42 @@
+#include "../include/solver.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#if defined(BSAT_REASON_SIDE_BUMP) || defined(BSAT_REASON_SIDE_TRACE)
+static void decision(Solver *s,Var v) {
+    s->decision_level++;s->trail_lims[s->decision_level]=s->trail_size;
+    s->values[v]=TRUE;s->vars[v].level=s->decision_level;
+    s->vars[v].reason=INVALID_CLAUSE;s->binary_reasons[v]=LIT_UNDEF;
+    s->vars[v].trail_pos=s->trail_size;s->trail[s->trail_size++]=(Trail){mkLit(v,false)};
+    assert(solver_propagate(s)==INVALID_CLAUSE);
+}
+int main(void) {
+    unsigned cases=0;
+    for(unsigned mode=0;mode<4;++mode) for(unsigned budget=0;budget<8;++budget)
+    for(unsigned large=0;large<2;++large) {
+        Solver *s=solver_new();assert(s);
+        for(unsigned v=0;v<6;++v)assert(solver_new_var(s));
+        Lit a[]={mkLit(1,true),mkLit(2,false)};
+        Lit b[]={mkLit(1,true),mkLit(2,true),mkLit(3,false)};
+        assert(solver_add_clause(s,a,2));assert(solver_add_clause(s,b,3));
+        decision(s,1);decision(s,4);
+        Lit learnt[]={mkLit(4,true),mkLit(2,true),mkLit(3,true)};
+        Lit before[3];memcpy(before,learnt,sizeof before);
+        double inc=large?1e101:1;s->order.var_inc=inc;
+        s->opts.vmtf=mode==1;s->opts.lrb=mode==2;s->interrupted=mode==3;
+        unsigned got=solver_reason_side_reward(s,learnt,3,budget,true);
+        unsigned expected=mode==0 && budget>0;
+        assert(got==expected && !memcmp(before,learnt,sizeof before));
+        for(Var v=1;v<=6;++v)assert(!s->seen[v] && isfinite(s->vars[v].activity));
+        assert((s->vars[1].activity>0)==(expected!=0));
+        assert(s->vars[2].activity==0 && s->vars[3].activity==0);
+        assert(s->vars[2].reason==INVALID_CLAUSE && s->binary_reasons[2]==mkLit(1,true));
+        assert(s->values[1]==TRUE && s->values[2]==TRUE && s->values[3]==TRUE);
+        solver_free(s);++cases;
+    }
+    printf("PASS: %u bounded reason-side reward cases\n",cases);
+    return 0;
+}
+#else
+int main(void) { puts("Reason-side prototype disabled");return 0; }
+#endif
