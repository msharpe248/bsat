+/* Compile-time research prototype: bounded one-hop reason-side VSIDS reward.
+ * Does not modify clauses, reasons, assignments, or the learned resolvent. */
+#if defined(BSAT_REASON_SIDE_BUMP) || defined(BSAT_REASON_SIDE_TRACE)
+unsigned solver_reason_side_reward(Solver *s, const Lit *learnt, uint32_t n,
+                                   uint32_t budget, bool reward) {
+    if (s->opts.vmtf || s->opts.lrb || s->interrupted || !budget) return 0;
+    uint32_t touched=0, added=0;
+    for (uint32_t i=0;i<n;++i) {
+        Var v=var(learnt[i]);
+        if (!s->seen[v]) { s->seen[v]=1;s->minimize_touched[touched++]=v; }
+    }
+    for (uint32_t i=1;i<n && budget;++i) {
+        if (solver_budget_exhausted(s)) break;
+        Var v=var(learnt[i]);CRef cr=s->vars[v].reason;
+        if (s->values[v]==UNDEF || !s->vars[v].level || cr==BINARY_CONFLICT) continue;
+        Lit binary=s->binary_reasons[v];
+        if (cr==INVALID_CLAUSE && binary==LIT_UNDEF) continue;
+        uint32_t size=cr==INVALID_CLAUSE?1:CLAUSE_SIZE(s->arena,cr);
+        const Lit *lits=cr==INVALID_CLAUSE?&binary:CLAUSE_LITS(s->arena,cr);
+        for (uint32_t j=0;j<size && budget;++j) {
+            --budget;
+            Var u=var(lits[j]);
+            if (u==v || s->seen[u] || s->values[u]==UNDEF || !s->vars[u].level ||
+                s->vars[u].trail_pos>=s->vars[v].trail_pos) continue;
+            s->seen[u]=1;s->minimize_touched[touched++]=u;++added;
+            if (reward) bump_var_activity(s,u,s->order.var_inc);
+        }
+    }
+    for (uint32_t i=0;i<touched;++i) s->seen[s->minimize_touched[i]]=0;
+    return added;
+}
+#endif
