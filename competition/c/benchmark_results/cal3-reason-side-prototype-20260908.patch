     s->vmtf.pending = 0;
     uint32_t index = s->trail_size - 1;
@@ -2327,6 +2360,23 @@ static lbool solve_internal_account_impl(Solver *s, const Lit *assumps, uint32_t
             uint32_t binary_removed = solver_minimize_binary(s,learnt,&n,lbd);
             s->stats.minimized_literals += binary_removed;
             if (binary_removed) lbd = calc_lbd(s,learnt,n);
+#if defined(BSAT_REASON_SIDE_BUMP) || defined(BSAT_REASON_SIDE_TRACE)
+            unsigned side=solver_reason_side_reward(s,learnt,n,10000,
+#ifdef BSAT_REASON_SIDE_BUMP
+                                                   true
+#else
+                                                   false
+#endif
+                                                   );
+#ifdef BSAT_REASON_SIDE_TRACE
+            fprintf(stderr,"c side-trace %llu %u %u %u %llu %llu\n",
+                    (unsigned long long)s->stats.conflicts,n,lbd,side,
+                    (unsigned long long)s->stats.decisions,
+                    (unsigned long long)s->stats.propagations);
+#else
+            (void)side;
+#endif
+#endif
             record_lbd(s,lbd);
