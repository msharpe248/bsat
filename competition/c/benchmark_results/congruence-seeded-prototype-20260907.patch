+        if (variant<2) assert(s->stats.congruence_merges>0);
+        s->work_limit=0;
+        assert(solver_solve(s)==(sat ? TRUE : FALSE));
+        if (sat) assert(solver_check_model(s));
+        solver_free(s);++tested;
+    }
+    printf("PASS: %u signed AND/XOR/ITE cases; %u with proved aliases; every added clause truth-table checked\n",tested,merges);
+}
