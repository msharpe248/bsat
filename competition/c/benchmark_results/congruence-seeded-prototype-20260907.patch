+    }
+    s=cascade(true);solver_congruence(s);assert(solver_solve(s)==FALSE && !s->error);solver_free(s);
+    printf("PASS: 65 congruence budget cutoffs and subsequent complete solves (full work %llu)\n",(unsigned long long)work);
+}
