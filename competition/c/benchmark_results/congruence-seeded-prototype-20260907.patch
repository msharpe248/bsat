+static void rup_guard(void) {
+    Solver *s=solver_new();assert(s);assert(solver_new_var(s));assert(solver_new_var(s));
+    Lit clause[]={mkLit(1,0),mkLit(2,0)};add(s,clause,2);
+    uint32_t clauses=s->num_clauses;size_t input=s->input_size;
+    assert(!solver_add_rup_clause(s,clause,1)); // x is not entailed by (x or y).
+    assert(s->num_clauses==clauses && s->input_size==input && !s->trail_size && !s->decision_level);
+    s->work=1;s->work_limit=1;
+    assert(!solver_add_rup_clause(s,clause,2) && s->num_clauses==clauses);
+    s->work_limit=0;assert(solver_add_rup_clause(s,clause,2));
